# Copy to .env. Expo inlines EXPO_PUBLIC_ variables into the bundle, so never put secrets here.

# Where the Rails API listens. A phone reads localhost as itself, so over Tailscale use this
# computer's Tailscale address or MagicDNS name instead (see README.md).
EXPO_PUBLIC_API_URL=http://localhost:3000

# The local demo token that backend/db/seeds/character_list.rb creates. The bundle exposes it to
# anyone who loads the app, so only use it for local development.
EXPO_PUBLIC_API_TOKEN=dev-character-list-token
